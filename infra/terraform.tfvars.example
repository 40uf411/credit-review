# Copy to terraform.tfvars (gitignored) and fill in. Not secrets, but keep them out of the public repo.
subscription_id = "00000000-0000-0000-0000-000000000000"

# Your Entra object ID, so you can call the models from your machine: az ad signed-in-user show --query id -o tsv
model_user_object_ids = ["00000000-0000-0000-0000-000000000000"]

# Model deployments default to variables.tf; override here only to change capacity or add gpt-5.5 once it has quota.

# Budget alerts for the application's resource group (none when empty).
budget_emails = ["you@example.com"]
