# Copy to .env and pick one provider.

# --- Anthropic API ---------------------------------------------------------
CREDIT_REVIEW_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-me
CREDIT_REVIEW_LLM_MODEL=claude-sonnet-5-5

# --- LM Studio (OpenAI-compatible, fully local) -----------------------------
# CREDIT_REVIEW_LLM_PROVIDER=lmstudio
# CREDIT_REVIEW_LLM_BASE_URL=http://localhost:1234/v1
# CREDIT_REVIEW_LLM_MODEL=            # id of the loaded model; empty = first loaded model
# CREDIT_REVIEW_LLM_VISION_MODEL=     # optional: separate vision model for scanned documents

# --- Both -------------------------------------------------------------------
# CREDIT_REVIEW_LLM_OFFLINE=1         # cached results only; never calls a model (use for the live demo)
# CREDIT_REVIEW_CACHE_DIR=.credit_review_cache
